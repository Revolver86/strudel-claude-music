// TRANSMISSION FROM THE VOID
// A 2-minute occult ritual in digital form
// Full song structure - intro, verses, breakdowns, climax, outro
// By Claude, channeled from beyond

setcps(160/60/4) // 160 BPM - ritualistic tempo

stack(
  // Blast beat foundation - evolving intensity
  sound("bd*<4 4 4 4 4 8 4 8 7 11 7>")
    .n("<0 1 2 1>")
    .crush("<5 4 4 3 3 3 2 2>")
    .shape("<8 9 10 12 15 18 12 5>")
    .speed("<1 0.9 1 1.2 1 0.8 1.5 -1>")
    .gain("<0.8 0.9 1 1 1.1 1.1 1.2 0.6>"),

  // Snare pattern - builds complexity
  sound("[~ sd]*2, [~ ~ ~ sd]")
    .crush("<4 4 3 3 3 2 2 6>")
    .shape("<9 10 12 15 20 12 5>")
    .gain("<0.7 0.8 0.9 0.9 0.8 0.5>"),

  // Hi-hats - intensity progression
  sound("hh*<0 8 8 8 16 16 24 0>")
    .crush("<4 4 4 3 3 2 6>")
    .gain("<0 0.4 0.4 0.5 0.5 0.6 0.3>"),

  // 8-bit possessed lead - Phrygian mode
  note("<[0 1 6 11]*8 [2 7 9 14]*8 [-2 3 8 13]*8 [1 6 10 15]*8 [0 1 6]*12 [-2 3 8]*24 [0 3 7]*32 ~>")
    .scale("c:phrygian")
    .sound("square")
    .crush("<6 5 4 4 3 3 2 6>")
    .lpf(sine.range(600, 2400).slow(8))
    .lpq("<8 10 12 15 20 8>")
    .shape("<5 7 8 10 15 20 8>")
    .gain("<0 0.5 0.55 0.6 0.6 0.65 0.7 0.3>")
    .pan(perlin),

  // Black metal tremolo - glitched
  note("[-12 -11 -12 -10]*<0 16 16 24 24 32 32 0>")
    .add("<0 1 6 7 0 2 11>")
    .sound("<~ sawtooth sawtooth sawtooth square sawtooth sawtooth ~>")
    .crush("<6 6 6 5 5 4 6>")
    .coarse("<16 16 12 12 8 16>")
    .lpf("<900 900 1200 1200 800 900>")
    .lpq("<8 8 12 15 12 8>")
    .gain("<0 0.55 0.6 0.65 0.7 0.7 0.5>")
    .pan(rand)
    .degradeBy("<0.3 0.25 0.25 0.3 0.3 0.4 0.5>"),

  // Cursed sub-bass - evolving
  note("[-24 -23 -24 -26]*<1 1 1 1 1 1 8 1>")
    .sound("sawtooth")
    .lpf("<180 180 180 200 200 150 100>")
    .shape("<14 16 16 18 20 22 20 10>")
    .distort("<1 1.2 1.2 1.5 1.5 2 1.8 0.5>")
    .crush("<4 3 3 2 2 2 3>")
    .gain("<0.6 0.7 0.8 0.85 0.85 0.9 0.9 0.5>"),

  // Schizophrenic 8-bit voices - breakdown sections
  note("<~ ~ [0 5 7 12]*8 ~ [0 3 7]*12 ~ [0 5]*16 ~>")
    .add("<0 0 5 0 7 0 12 0>")
    .sound("triangle")
    .crush("<6 6 5 6 4 6 3 6>")
    .bpf(perlin.range(800, 3500).slow(2))
    .bpq("<20 25 30 25 20>")
    .shape("<8 10 12 15 10>")
    .gain("<0 0 0.4 0 0.5 0 0.6 0>")
    .pan(rand)
    .degradeBy("<0.5 0.5 0.5 0.5 0.4 0.5 0.6 0.8>"),

  // Industrial noise layers
  sound("<~ ~ white*8 ~ pink*8 ~ brown*16 brown*4>")
    .hpf("<4000 4000 4000 4000 3000 4000 5000>")
    .crush("<3 3 3 3 2 3 4>")
    .gain("<0 0 0.3 0 0.4 0 0.5 0.2>")
    .pan(rand)
    .shape("<8 10 15 20 10>")
    .degradeBy("<0.6 0.6 0.5 0.6 0.5 0.7 0.7>"),

  // Paranoid whispers - sine waves
  note("<~ ~ [-48 -47 -45 -44]*8 ~ [-48 -46 -44]*8 ~ ~ [-36 -37 -35]*4>")
    .sound("sine")
    .crush("<4 4 4 4 2 4>")
    .gain("<0 0 0.3 0 0.35 0 0 0.25>")
    .pan(sine.slow(16))
    .degradeBy("<0.3 0.3 0.3 0.5 0.7 0.9>"),

  // Alien drones - breakdown
  note("<~ ~ ~ ~ <[-12 -11] [-14 -9]>*8 ~ ~ ~>")
    .sound("triangle")
    .crush("<4 4 4>")
    .coarse("<24 24 24>")
    .lpf(perlin.range(300, 1200).slow(4))
    .gain("<0 0 0 0 0.4 0 0 0>")
    .shape("<6 6 6>")
    .pan(sine.slow(8)),

  // Glitched apparitions
  sound("<~ ~ ~ ~ <bd sd hh cp>*8 ~ <bd sd>*32 ~>")
    .n("<0 1 2 3>")
    .speed("<1 -1 2 0.5>")
    .crush("<5 4 3 2>")
    .gain("<0 0 0 0 0.4 0 0.5 0.2>")
    .pan(rand)
    .degradeBy("<0.7 0.7 0.7 0.8 0.9>"),

  // Subsonic destruction
  note("[-36 -35 -36 -33]*<0 0 0 0 0 0 8 0>")
    .sound("sawtooth")
    .lpf("<150 150 150>")
    .shape("<20 22 20>")
    .distort("<2 2 1.5>")
    .crush("<2 2 3>")
    .gain("<0 0 0 0 0 0 0.85 0>")
)
