    .lpf("<1200 1200 1200 1200 800 600 1200 1200 1200 1200 1200 1200 1200 800 1200 1200 1200 600 1200 800 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200 1200>")
    .lpq(3)
    .gain("<0 0 0 0.4 0.4 0.3 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.3 0.4 0.4 0.4 0.3 0.4 0.3 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.35 0.3 0.25 0.2 0>")
