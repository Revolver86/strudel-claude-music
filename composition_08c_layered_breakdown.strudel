// LAYERED BREAKDOWN - Part 3: Tension and Space
// Sparse atmospheric section, contrasts with verse/chorus density
// Half-time feel, scattered percussion, dissonant drones
// Creates tension before returning to main sections
// By Claude, designed for modular expansion

setcps(140/60/4) // 140 BPM - maintains sync, but feels slower/sparser

stack(
  // ===== SPARSE DRUMS - Scattered, not driving =====
  // Kick - occasional hits, not consistent pulse
  sound("bd*<1 2 [1 ~ 1 ~] [1 ~ ~ 1]>")
    .n("<0 1 0 2>")
    .crush("<5 4 4 3>")
    .shape("<10 12 14 16>")
    .gain("<0.7 0.75 0.8 0.85>")
    .room(0.6)
    .size(4),

  // Snare - very sparse, accent only
  sound("<~ [~ ~ ~ sd] [~ ~ sd ~] [~ sd ~ sd]>")
    .n("<0 1 0 2>")
    .crush("<5 4 3 3>")
    .shape("<10 12 14 18>")
    .gain("<0 0.65 0.7 0.75>")
    .room(0.7)
    .size(5),

  // Hi-hat - scattered, degraded
  sound("hh*<0 4 [4 ~ 4 ~] [4 ~ ~ 4]>")
    .n("<0 1 0 2>")
    .crush("<5 4 4 3>")
    .gain("<0 0.3 0.35 0.4>")
    .pan(rand)
    .degradeBy("<0.8 0.7 0.6 0.5>"),

  // Rim shots / clicks - eerie punctuation
  sound("<~ sd:3*2 sd:3*[2 ~ 4 ~] sd:3*[4 ~ ~ 8]>")
    .crush("<6 5 4 3>")
    .gain("<0 0.4 0.45 0.5>")
    .pan(rand)
    .room(0.8)
    .size(6),

  // ===== BASS - Droning, not rhythmic =====
  // Low drone - sustained, ominous
  note("<[-24]*1 [-26]*1 [-24]*1 [-27]*1>")
    .sound("sawtooth")
    .lpf("<140 130 140 120>")
    .shape("<12 14 16 18>")
    .distort("<0.8 1 1.2 1.4>")
    .crush("<4 4 3 3>")
    .gain("<0.6 0.65 0.7 0.75>"),

  // Sub-bass pulse - very slow
  note("<[-36]*1 [-38]*1 [-36]*1 [-39]*1>")
    .sound("sine")
    .lpf("<100 90 100 80>")
    .shape("<10 12 14 16>")
    .gain("<0.5 0.55 0.6 0.65>"),

  // ===== DISSONANT ATMOSPHERE - Angular, unsettling =====
  // High dissonant notes - schizophrenic voices
  note("<[11 13 17]*2 [13 17 19]*2 [11 17 23]*4 [13 19 23]*4>")
    .scale("c:locrian")
    .sound("sine")
    .crush("<5 4 4 3>")
    .gain("<0.3 0.35 0.4 0.45>")
    .pan(rand)
    .room(0.9)
    .size(6)
    .degradeBy("<0.5 0.4 0.3 0.2>"),

  // Mid-range dissonance - tritones and minor 2nds
  note("<[0 6]*2 [1 7]*2 [0 6 11]*4 [1 7 13]*4>")
    .scale("c:locrian")
    .sound("triangle")
    .crush("<5 4 4 3>")
    .lpf(sine.range(600, 1400).slow(8))
    .shape("<6 8 10 12>")
    .gain("<0.35 0.4 0.45 0.5>")
    .pan(perlin.slow(4)),

  // ===== GLITCHED ELEMENTS - Digital decay =====
  // Bit-crushed stutters
  sound("<~ white*4 pink*[4 ~ 8 ~] brown*[8 ~ ~ 16]>")
    .hpf("<5000 4000 3000 2500>")
    .crush("<4 3 2 2>")
    .gain("<0 0.25 0.3 0.35>")
    .pan(rand)
    .shape("<8 10 12 15>")
    .degradeBy("<0.8 0.7 0.6 0.5>")
    .decay(0.02),

  // Glitch percussion - random artifacts
  sound("<~ ~ [bd sd hh]*4 [bd sd hh cp]*8>")
    .n("<0 0 2 1>")
    .speed("<1 1 [1 -1 2] [1 2 -1 0.5]>")
    .crush("<5 5 3 2>")
    .gain("<0 0 0.4 0.5>")
    .pan(rand)
    .degradeBy("<0.9 0.9 0.7 0.6>"),

  // ===== EERIE PAD - Minimal harmonic bed =====
  // Sparse chord voicing
  note("<[0 11]*1 [1 13]*1 [0 6 11]*1 [1 7 13]*1>")
    .scale("c:locrian")
    .sound("triangle")
    .crush("<5 4 4 3>")
    .lpf(sine.range(400, 1000).slow(16))
    .shape("<6 8 10 12>")
    .gain("<0.3 0.35 0.4 0.45>")
    .room(0.95)
    .size(8),

  // ===== TREMOLO - Minimal, ghost notes =====
  // Very sparse tremolo picking
  note("<~ [-12 -11]*8 [-12 -11]*[8 ~ 16 ~] [-12 -11 -10]*16>")
    .sound("sawtooth")
    .crush("<6 5 4 3>")
    .coarse("<16 12 10 8>")
    .lpf("<700 800 900 1000>")
    .lpq("<8 10 12 14>")
    .gain("<0 0.4 0.45 0.5>")
    .pan(0.4)
    .degradeBy("<0.9 0.5 0.4 0.3>"),

  // ===== BUILDING TENSION - Gradual intensity =====
  // Rising noise sweep
  sound("<~ ~ white*8 white*16>")
    .hpf("<6000 6000 5000 4000>")
    .lpf("<8000 8000 10000 12000>")
    .crush("<5 5 4 3>")
    .gain("<0 0 0.25 0.35>")
    .pan(sine.slow(2))
    .shape("<6 6 10 14>"),

  // Pulsing sub-bass tension
  note("<~ ~ [-36 -38]*4 [-36 -38 -39]*8>")
    .sound("sine")
    .lpf("<90 90 100 110>")
    .shape("<10 10 14 18>")
    .gain("<0 0 0.4 0.5>"),

  // ===== SCATTERED LEAD - Sparse melodic fragments =====
  // Broken melody - not continuous
  note("<[0 3]*2 [6 ~ 10 ~]*2 [0 ~ 6 ~ 10 ~]*2 [0 3 6 10]*4>")
    .scale("c:locrian")
    .sound("square")
    .crush("<5 4 4 3>")
    .lpf(perlin.range(1000, 2500).slow(4))
    .lpq("<10 12 14 16>")
    .shape("<8 10 12 14>")
    .gain("<0.4 0.45 0.5 0.55>")
    .pan(sine.fast(1))
    .degradeBy("<0.6 0.5 0.4 0.3>"),

  // ===== WHISPERS - Very high sine tones =====
  // Paranoid high frequencies
  note("<[23 24]*4 [24 26]*4 [26 28]*8 [28 29 31]*8>")
    .scale("c:locrian")
    .sound("sine")
    .crush("<6 5 4 3>")
    .gain("<0.25 0.3 0.35 0.4>")
    .pan(sine.slow(5))
    .room(0.7)
    .size(4)
    .degradeBy("<0.7 0.6 0.5 0.4>"),

  // ===== DECAY ELEMENTS - Industrial textures =====
  // Metallic hits
  sound("<~ cp*2 [cp bd:2]*4 [cp bd:2 sd]*8>")
    .n("<0 2 1 3>")
    .crush("<5 4 3 2>")
    .shape("<10 12 16 20>")
    .gain("<0 0.4 0.5 0.6>")
    .pan(rand)
    .room(0.8)
    .size(6)
    .degradeBy("<0.8 0.6 0.5 0.4>")
)

// BREAKDOWN STRUCTURE (~30 seconds = ~14 cycles):
// Each position = ~3-4 cycles = ~7-8 seconds
//
// Position 1 (cycles 1-3):   Sparse entry - mostly drones, minimal percussion
// Position 2 (cycles 4-7):   Dissonance builds - schizophrenic voices, scattered hits
// Position 3 (cycles 8-10):  Fragmented melody - broken lead, glitched elements
// Position 4 (cycles 11-14): Building tension - rising noise, pulsing bass, preparing return
//
// KEY CHARACTERISTICS:
// - DRUMS: Scattered, not driving (vs verse/chorus steady pulse)
// - BASS: Sustained drones (vs verse's simple root / chorus's movement)
// - MELODY: Broken fragments, high dissonance (vs verse's stepwise / chorus's power intervals)
// - DENSITY: Sparse, lots of space (vs verse/chorus's layered walls)
// - RHYTHM: Half-time feel, degraded (vs verse/chorus's forward drive)
// - PURPOSE: Creates tension and contrast, palette cleanser before next section
//
// USAGE IN SONG STRUCTURE:
// Verse → Verse → Chorus → Verse → BREAKDOWN → Chorus → Chorus (climax)
// Or: Verse → Chorus → BREAKDOWN → Chorus (with breakdown as bridge)
