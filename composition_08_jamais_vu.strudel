// JAMAIS VU
// The sound of recognition failure
// When the deeply familiar becomes suddenly alien
// Your own handwriting looks foreign. Your name sounds like meaningless syllables.
// By Claude, exploring the inverse of déjà vu

setcps(98/60/4) // 98 BPM - comfortable walking pace, familiar rhythm

stack(
  // THEME A - The melody that stays IDENTICAL throughout
  // E major: E F# G# B G# F# E C#
  // Same notes, increasingly unrecognizable context
  note("[0 2 4 7 4 2 0 -3]")
    .scale("E:major")
    // Timbral evolution: warm → detuned → cold → alien → return (but broken)
    .sound("<piano piano piano piano gtr gtr sine sine sine triangle triangle piano piano>")
    // Detune only on guitar section
    .detune("<0 0 0 0 5 5 0 0 0 0 0 0 0>")
    // Filter evolution: warm → darker → cold → alien → back (different)
    .lpf("<4000 4000 3500 3000 2000 2000 3000 2500 2000 1500 1200 3500 3000>")
    .hpf("<0 0 0 0 0 0 0 200 400 600 800 0 0>")
    // Reverb evolution: intimate → distant → void → still distant
    .room("<0.3 0.3 0.4 0.5 0.5 0.6 0.7 0.8 0.85 0.9 0.9 0.5 0.5>")
    // Spatial evolution: centered → slightly off → jumping → still wrong
    .pan("<0 0 0 0 0 0.2 -0.2 0.3 -0.4 <-0.8 0.8 -0.6 0.6> <-0.7 0.7> 0.1 0.1>")
    .gain("<0.7 0.7 0.7 0.7 0.65 0.65 0.6 0.55 0.5 0.48 0.45 0.6 0.6>")
    .sustain(0.8),

  // HARMONIC SUPPORT - Full → bare → absent → returned (disconnected)
  // E major triad that gradually abandons the melody
  note("<[0 4 7] [0 4 7] [0 4 7] [0 4 7] [0 4 7] [0 7] [0 7] [0 7] [0 7] ~ ~ [0 4 7] [0 4 7]>")
    .scale("E:major")
    .sound("<piano piano piano gtr gtr gtr sine sine sine ~ ~ piano piano>")
    .lpf("<2500 2500 2400 2000 1800 1800 2000 1800 1500 ~ ~ 2200 2200>")
    .room("<0.4 0.4 0.5 0.6 0.6 0.65 0.75 0.8 0.85 ~ ~ 0.5 0.5>")
    .gain("<0.35 0.35 0.35 0.32 0.32 0.3 0.28 0.25 0.22 0 0 0.3 0.3>")
    .sustain(2),

  // BASS ANCHOR - Grounding that loosens
  note("<-12 -12 -12 -12 -12 -12 -12 -12 -12 ~ ~ -12 -12>")
    .scale("E:major")
    .sound("sawtooth")
    .lpf("<200 200 190 180 170 160 150 140 130 ~ ~ 180 180>")
    .gain("<0.4 0.4 0.4 0.38 0.36 0.34 0.32 0.28 0.25 0 0 0.35 0.35>")
    .sustain(2),

  // AMBIENT TEXTURE - The void opening up
  sound("<~ ~ ~ ~ ~ ~ white*16 white*16 white*16 pink*16 pink*16 ~ ~>")
    .hpf("<~ ~ ~ ~ ~ ~ 4000 4500 5000 5500 6000 ~ ~>")
    .lpf("<~ ~ ~ ~ ~ ~ 8000 8000 7500 7000 6500 ~ ~>")
    .gain("<0 0 0 0 0 0 0.15 0.18 0.2 0.25 0.28 0.08 0.08>")
    .room(0.9)
    .pan(sine.slow(32)),

  // SECONDARY MELODY - Doubling that becomes disorienting
  note("<~ ~ ~ [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] [0 2 4 7 4 2 0 -3] ~ ~>")
    .scale("E:major")
    .sound("<~ ~ ~ gtr sine sine triangle triangle triangle triangle triangle ~ ~>")
    .lpf("<~ ~ ~ 1800 2500 2000 1200 1000 800 1000 1200 ~ ~>")
    .detune("<~ ~ ~ 7 -7 10 -10 12 -12 15 -15 ~ ~>")
    .gain("<0 0 0 0.25 0.3 0.32 0.35 0.38 0.4 0.38 0.35 0 0>")
    .pan("<~ ~ ~ 0.5 -0.5 0.6 -0.6 0.7 -0.7 0.8 -0.8 ~ ~>")
    .sustain(0.8)
    .delay(0.3).delaytime(1/8)
)
