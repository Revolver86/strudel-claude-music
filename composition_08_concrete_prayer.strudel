// CONCRETE PRAYER
// Urban apocalyptic black metal - 180 BPM, G# minor
// Prayer in concrete wilderness, spiritual warfare in decaying cities

setcps(180/60/4) // 180 BPM - relentless aggression

stack(
  // INTRO: Industrial machinery grinding (20 seconds intro)
