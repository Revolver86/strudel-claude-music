// MEMETIC KILL AGENT
// Digital Black Metal - Information Warfare
// 190 BPM - B Locrian Mode
// SCP Foundation: Ideas as Weapons

setcps(190/60/4) // 190 BPM black metal tempo

stack(
  // THREAT DETECTED → ENGAGEMENT → RELOAD → SUPPRESSION → OVERWHELMING FORCE → TARGET DESTROYED

  // Driving kick pattern - evolves from noise intro to devastating groove
  sound("bd*<8 16 0 16 16 16>")
    .n("<2 5 0 5 5 5>")
    .crush("<3 5 10 5 4 3>")
    .shape("<8 5 0 6 8 7>")
    .lpf("<300 150 0 140 150 130>")
    .distort("<0.9 0.5 0 0.5 0.6 0.5>")
    .gain("<1.3 1.1 0 1.2 1.0 1.3>"),

  // Snare - on 2 and 4 with variations
  sound("[~ sd ~ sd]*<1 1 0 1 1 1>")
    .n("<3 3 0 3 3 3>")
    .crush("<5 5 0 5 6 4>")
    .distort("<0.7 0.7 0 0.8 0.9 0.8>")
    .hpf("<400 400 0 400 400 500>")
    .gain("<1.0 1.0 0 1.1 1.0 1.2>"),

  // Hi-hats - relentless precision to machine-gun chaos
  sound("hh*<16 16 16 16 16 16>")
    .n("<8 8 8 8 8 8>")
    .hpf("<8000 8000 9000 8500 9000 8000>")
    .crush("<0 0 0 0 0 0>")
    .gain("<0.7 0.7 0.9 0.8 0.75 0.8>")
    .pan("<0.5 [0.4 0.6] 0.5 [0.2 0.8] [0 1] [0.4 0.6]>"),

  // MAIN TREMOLO RIFF - B Locrian (B C D E F G A)
  // Intro: noise → Verse 1: tremolo → Breakdown: silent → Verse 2: palm mutes + tremolo → Bridge: staccato → Climax: groove
  note("<[b1 [~ b1] b1 ~]*16 [b2 f2 c3 e2]*16 ~ [[b2!4]*4 [f2*16] [c3*16] [e2!4]*4] [b2!4 ~!2 f2!4 ~!2 c3!4 ~!2 e2!4 ~!2] [b2!4 b1!4 f2!4 c3!4]>")
    .sound("<square square ~ square square square>")
    .crush("<3 5 0 5 4 5>")
    .shape("<9 9 0 9 95 95>")
    .lpf("<[200 8000] 3500 0 [2000 4000 3500 2500] 3000 2500>")
    .hpf("<0 200 0 150 0 150>")
    .distort("<1 0.8 0 0.85 0.9 0.9>")
    .gain("<1.2 0.8 0 0.85 0.95 0.9>")
    .pan("<[0 1] 0.3 0 0.25 0.5 0.3>"),

  // HARMONY LAYER - minor third up
  note("<~ [d3 a2 e3 g3]*16 ~ [d3 a2 e3 g3]*8 [d3!4 ~!2 a2!4 ~!2 e3!4 ~!2 g3!4 ~!2] [d3 a2 e3 g3]*8>")
    .sound("square")
    .crush("<0 5 0 6 7 6>")
    .shape("<0 9 0 9 95 9>")
    .lpf("<0 4000 0 4500 6000 4000>")
    .hpf("<0 250 0 250 1000 250>")
    .distort("<0 0.8 0 0.8 0.9 0.8>")
    .gain("<0 0.7 0 0.6 0.5 0.5>")
    .pan("<0 0.7 0 0.75 [0 1] 0.65>"),

  // DISSONANT TRITONE LAYER - cutting through
  note("<~ [f3 b2 f#3 a#3]*8 ~ [f3 b2 f#3]*4 [[b3 f3 c4]*8 [e3 a3 d4]*8] [f3 b2 f#3]*4>")
    .sound("square")
    .crush("<0 6 0 6 7 7>")
    .shape("<0 95 0 9 95 9>")
    .lpf("<0 5000 0 4500 6000 5000>")
    .hpf("<0 800 0 800 1000 800>")
    .distort("<0 0.9 0 0.8 0.9 0.9>")
    .gain("<0 0.6 0 0.6 0.5 0.55>")
    .pan("<0 0.5 0 0.5 [0 1] [0.3 0.7]>"),

  // PIERCING 8-BIT LEAD - alarm/siren (enters verse 2, climax)
  note("<~ ~ ~ [b4 a4 g4 f4 e4 d4 c4 b3]*2 [b4 a4 g4 f4]*4 [b4 a4 g4 f4]*4>")
    .sound("square")
    .crush("<0 0 0 2 2 2>")
    .lpf("<0 0 0 12000 10000 10000>")
    .hpf("<0 0 0 2000 2000 2000>")
    .gain("<0 0 0 0.7 0.65 0.65>")
    .room("<0 0 0 0.3 0 0>")
    .pan("<0 0 0 [0.2 0.8] [0.5 0.5] 0.5>"),

  // OMINOUS BASS PULSE - breakdown only
  note("<~ ~ [b1 f1]*2 ~ ~ ~>")
    .sound("square")
    .crush("<0 0 8 0 0 0>")
    .shape("<0 0 95 0 0 0>")
    .lpf("<0 0 180 0 0 0>")
    .distort("<0 0 1 0 0 0>")
    .gain("<0 0 1.2 0 0 0>")
    .room("<0 0 0.2 0 0 0>"),

  // SUBSONIC BASS - builds throughout
  note("<~ [-24 -23 -24 -26] [-24 -23] [-24 -23 -24 -26]*2 [-24 -23 -24]*4 [-24 -23 -24 -26]*2>")
    .sound("sawtooth")
    .lpf("<0 180 100 180 150 130>")
    .shape("<0 14 10 16 20 18>")
    .distort("<0 1 0.5 1.2 1.5 1.5>")
    .crush("<0 4 10 3 2 2>")
    .gain("<0 0.6 0.3 0.7 0.85 0.9>"),

  // CHAOS LAYERS - bridge section (stereo warfare)
  sound("<~ ~ ~ ~ [white*16 pink*16] ~>")
    .hpf("<0 0 0 0 [4000 3000] 0>")
    .crush("<0 0 0 0 3 0>")
    .gain("<0 0 0 0 0.4 0>")
    .pan("<0 0 0 0 [0 1] 0>")
    .shape("<0 0 0 0 15 0>")
)
