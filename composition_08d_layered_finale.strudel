// LAYERED FINALE/OUTRO - Part 4: Climax to Void
// Maximum intensity decaying into nothingness
// Starts with everything, ends with subsonic silence
// Final 30 seconds of the composition
// By Claude, designed for modular expansion

setcps(140/60/4) // 140 BPM - maintains sync

stack(
  // ===== DRUMS - Maximum to silence =====
  // Kick - blast to fade
  sound("bd*<11 8 4 1>")
    .n("<1 0 1 0>")
    .crush("<2 3 4 5>")
    .shape("<22 18 14 10>")
    .speed("<1.2 1 0.9 0.8>")
    .gain("<1.2 1 0.8 0.5>"),

  // Snare - chaos to scattered
  sound("[~ sd, sd*8]*<2 2 1 0>")
    .n("<2 1 0 0>")
    .crush("<2 3 4 6>")
    .shape("<20 16 12 8>")
    .gain("<1 0.85 0.6 0>"),

  // Hi-hats - dense to nothing
  sound("hh*<32 24 16 0>")
    .n("<2 1 0 0>")
    .crush("<2 3 4 6>")
    .gain("<0.7 0.5 0.3 0>")
    .pan(rand),

  // Crash/cymbal - climax emphasis
  sound("hh:2*<8 4 2 ~>")
    .crush("<3 4 5 6>")
    .gain("<0.8 0.6 0.4 0>")
    .room(0.5)
    .size(6),

  // ===== BASS - Destruction to drone =====
  // Main bass - heavy movement to sustained
  note("[-24 -22 -27 -24]*<8 4 2 1>")
    .sound("sawtooth")
    .lpf("<200 180 150 120>")
    .shape("<24 20 16 12>")
    .distort("<2.5 2 1.5 1>")
    .crush("<2 2 3 4>")
    .gain("<1.1 0.95 0.8 0.6>"),

  // Sub-bass - maximum destruction
  note("[-36 -34 -39 -36]*<8 4 2 1>")
    .sound("sawtooth")
    .lpf("<140 120 100 80>")
    .shape("<26 22 18 14>")
    .distort("<3 2.5 2 1.5>")
    .crush("<2 2 3 4>")
    .gain("<1 0.9 0.75 0.6>"),

  // Subsonic rumble - persists to the end
  note("<[-48 -47]*4 [-48 -46]*2 [-48]*1 [-48]*1>")
    .sound("sine")
    .lpf("<60 50 40 30>")
    .shape("<20 18 16 14>")
    .gain("<0.8 0.75 0.7 0.6>"),

  // ===== LEADS - Maximum chaos to whispers =====
  // Power chord stabs - everything firing
  note("[0 7 12 17, 12 19 24 29]*<16 8 4 0>")
    .scale("c:locrian")
    .sound("square")
    .crush("<2 3 4 6>")
    .lpf(sine.range(2000, 5000).slow(2))
    .lpq("<25 20 15 10>")
    .shape("<22 18 14 10>")
    .gain("<0.9 0.75 0.6 0>")
    .pan(perlin),

  // Tremolo wall - dense to sparse
  note("[-12 -10 -15 -12]*<32 24 16 0>")
    .sound("sawtooth")
    .crush("<3 4 5 6>")
    .coarse("<8 10 12 16>")
    .lpf("<1200 1000 800 600>")
    .lpq("<20 16 12 8>")
    .gain("<0.85 0.7 0.5 0>")
    .pan(0.3)
    .degradeBy("<0.1 0.2 0.3 0.5>"),

  // Tremolo right - stereo destruction
  note("[-5 -3 -8 -5]*<32 24 16 0>")
    .sound("sawtooth")
    .crush("<3 4 5 6>")
    .coarse("<8 10 12 16>")
    .lpf("<1200 1000 800 600>")
    .lpq("<20 16 12 8>")
    .gain("<0.85 0.7 0.5 0>")
    .pan(0.7)
    .degradeBy("<0.1 0.2 0.3 0.5>"),

  // ===== NOISE - Maximum chaos to void =====
  // White noise explosion
  sound("white*<32 24 16 8>")
    .hpf("<2000 2500 3000 4000>")
    .lpf("<12000 10000 8000 6000>")
    .crush("<2 3 4 5>")
    .gain("<0.5 0.4 0.3 0.2>")
    .pan(rand)
    .shape("<20 16 12 8>")
    .degradeBy("<0.2 0.3 0.4 0.6>"),

  // Brown noise low rumble
  sound("brown*<16 12 8 4>")
    .lpf("<500 400 300 200>")
    .crush("<2 3 4 5>")
    .gain("<0.5 0.4 0.3 0.2>")
    .shape("<18 14 10 6>"),

  // ===== PADS - Harmonic decay =====
  // Power chord pad - fading
  note("[0 7 12 19]*<4 2 1 1>")
    .scale("c:locrian")
    .sound("triangle")
    .crush("<3 4 5 6>")
    .lpf(sine.range(1000, 2000).slow(8))
    .shape("<16 12 8 6>")
    .gain("<0.7 0.6 0.5 0.4>")
    .room(0.95)
    .size(8),

  // ===== INDUSTRIAL CHAOS - Maximum destruction =====
  // Glitch chaos - all samples firing
  sound("[bd sd hh cp]*<32 24 16 0>")
    .n("<2 1 0 0>")
    .speed("<[1 2 -1 0.5] [1 -1 2] [1 0.5] 1>")
    .crush("<2 3 4 6>")
    .gain("<0.7 0.6 0.4 0>")
    .pan(rand)
    .degradeBy("<0.4 0.5 0.6 0.8>")
    .shape("<20 16 12 8>"),

  // Metallic destruction
  sound("<[cp bd:2 sd]*24 [cp bd:2]*16 [cp]*8 ~>")
    .n("<3 2 1 0>")
    .speed("<[1 2 -1] [1 2] 1 1>")
    .crush("<2 3 4 6>")
    .shape("<22 18 14 10>")
    .gain("<0.8 0.65 0.5 0>")
    .pan(rand)
    .room(0.6)
    .size(5),

  // ===== HIGH FREQUENCIES - Whispers remain =====
  // Schizophrenic voices - persist longer
  note("<[28 29 31]*16 [26 28]*12 [24 26]*8 [23 24]*4>")
    .scale("c:locrian")
    .sound("sine")
    .crush("<3 4 5 6>")
    .gain("<0.5 0.45 0.4 0.35>")
    .pan(sine.slow(3))
    .room(0.8)
    .size(6)
    .degradeBy("<0.3 0.4 0.5 0.6>"),

  // Dissonant high cluster
  note("<[11 13 17 19 23]*8 [11 13 17]*6 [11 13]*4 [11]*2>")
    .scale("c:locrian")
    .sound("sine")
    .crush("<4 5 6 6>")
    .gain("<0.4 0.35 0.3 0.25>")
    .pan(rand)
    .room(0.9)
    .size(7)
    .degradeBy("<0.4 0.5 0.6 0.7>"),

  // ===== CLIMAX ELEMENTS - Beginning only =====
  // Octave-doubled leads - maximum intensity
  note("<[12 19 24 29, 24 31 36 41]*16 ~ ~ ~>")
    .scale("c:locrian")
    .sound("square")
    .crush("<2 6 6 6>")
    .coarse("<6 12 12 12>")
    .lpf(perlin.range(3000, 6000).slow(1))
    .lpq("<28 10 10 10>")
    .shape("<24 10 10 10>")
    .gain("<0.85 0 0 0>")
    .pan(sine.fast(4)),

  // Subsonic destruction pulse - climax
  note("<[-36 -34 -39 -36]*16 [-36 -38]*8 [-36]*4 [-36]*2>")
    .sound("sawtooth")
    .lpf("<120 100 80 60>")
    .shape("<28 24 20 16>")
    .distort("<3.5 3 2.5 2>")
    .crush("<1 2 3 4>")
    .gain("<1.1 0.95 0.8 0.65>"),

  // Final decay oscillator - fades to silence
  note("<~ ~ [-60]*2 [-60]*1>")
    .sound("sine")
    .lpf("<20 20 15 10>")
    .shape("<12 12 10 8>")
    .gain("<0 0 0.5 0.3>")
)

// FINALE/OUTRO STRUCTURE (~30 seconds = ~14 cycles):
// Each position = ~3-4 cycles = ~7-8 seconds
//
// Position 1 (cycles 1-3):   MAXIMUM CLIMAX - everything firing at once, total destruction
//                             All drums blasting, all bass layers, all leads, maximum chaos
//                             The peak of the entire composition
//
// Position 2 (cycles 4-7):   STRIPPING LAYERS - percussion reduces, leads fade
//                             Maintaining intensity but removing top layers
//                             Industrial chaos diminishing
//
// Position 3 (cycles 8-10):  DISSOLVING - mostly drones and whispers remain
//                             Sparse percussion, bass drones, high voices
//                             Noise fading, space appearing
//
// Position 4 (cycles 11-14): VOID - subsonic rumble and silence
//                             Only deep bass, faint whispers, decay
//                             Fading into nothingness
//
// KEY CHARACTERISTICS:
// - INTENSITY: Maximum → decay (vs all other sections which build or sustain)
// - LAYERS: Everything → nothing (stripping away until void)
// - PURPOSE: Climactic peak + resolution, brings song to final rest
// - DRAMA: Starts as the most intense moment, ends as the quietest
//
// USAGE IN SONG STRUCTURE:
// Verse → Verse → Chorus → Verse → Breakdown → Chorus → Chorus → FINALE
// Or: Verse → Chorus → Breakdown → Chorus → FINALE
// Or: Verse → Chorus → Verse → Chorus → FINALE (if you want to skip breakdown)
//
// This is the FINAL statement - the song's peak and its ending combined
