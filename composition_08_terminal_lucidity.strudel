// TERMINAL LUCIDITY
// The phenomenon where people with advanced dementia suddenly regain
// complete clarity hours before death. The fog lifts. They're whole again.
// Then they're gone.
//
// Three phases using .segment() for time-based evolution:
// PHASE 1: The Fog (degraded, struggling, barely coherent)
// PHASE 2: The Spike (impossible crystalline clarity)
// PHASE 3: The Silence (hard cut to nothing)
//
// By Claude, for everyone who got to say goodbye

setcps(65/60/4) // Starts at 65 BPM - labored, struggling

stack(
  // BASSLINE - fragments that lose themselves, then become whole
  note("0 ~ 3 ~ ~ 0 ~ ~".segment(32))
    .off(1/4, x => x.add(7))
    .scale("bb:minor")
    .sound("sawtooth")
    .oct(2)
    .lpf(perlin.range(400, 900).slow(16).segment(16, perlin.range(400, 20000).slow(8)))
    .lpq(sine.range(3, 6).slow(8).segment(16, 1))
    .gain(sine.range(0.4, 0.7).slow(16).segment(16, 0.9))
    .room(sine.range(0.4, 0.7).slow(8).segment(16, 0))
    .degradeBy(sine.range(0.2, 0.5).slow(16).segment(16, 0))
    .slow(perlin.range(1, 1.3).slow(8).segment(16, 0.5)), // Tempo doubles at segment 16

  // MELODY - incomplete phrases that suddenly remember everything
  note("7 9 ~ ~ 9 10 ~ ~".segment(32))
    .off(1/8, x => x.add("2 3 5"))
    .scale("bb:minor".segment(16, "bb:lydian"))
    .sound("square".segment(16, "sine"))
    .oct(5)
    .lpf(perlin.range(500, 800).slow(16).segment(16, 20000))
    .lpq(sine.range(4, 7).slow(8).segment(16, 1))
    .gain(sine.range(0.2, 0.4).slow(16).segment(16, 0.7))
    .room(sine.range(0.5, 0.8).slow(8).segment(16, 0))
    .degradeBy(sine.range(0.3, 0.6).slow(16).segment(16, 0))
    .slow(perlin.range(1, 1.3).slow(8).segment(16, 0.5)),

  // DRUMS - stumbling rhythm that finds itself
  sound("bd ~ ~ ~ ~ bd ~ ~".segment(32))
    .n("0 1".slow(4))
    .gain(sine.range(0.5, 0.7).slow(16).segment(16, 0.9))
    .room(sine.range(0.3, 0.5).slow(8).segment(16, 0))
    .degradeBy(sine.range(0.2, 0.4).slow(16).segment(16, 0))
    .slow(perlin.range(1, 1.2).slow(8).segment(16, 0.5)),

  // SNARE - absent in fog, crystalline in clarity
  sound("~ ~ sd ~".segment(32))
    .gain("0".segment(16, sine.range(0.6, 0.8).slow(8)))
    .room("0.5".segment(16, 0))
    .slow("1".segment(16, 0.5)),

  // HI-HATS - only appear during clarity
  sound("~".segment(16, "hh*8"))
    .gain("0".segment(16, sine.range(0.3, 0.5).slow(8)))
    .slow("1".segment(16, 0.5)),

  // PADS - foggy ambience that lifts
  note("[0 3 7]*2".segment(16, "~"))
    .scale("bb:minor".segment(8, "db:minor"))
    .sound("sawtooth")
    .oct(3)
    .lpf(perlin.range(300, 500).slow(16))
    .lpq(8)
    .gain(sine.range(0.2, 0.4).slow(16).segment(16, 0))
    .room(0.9)
    .slow(perlin.range(1, 1.2).slow(8)),

  // CRYSTALLINE HARMONY - pure Lydian clarity (only Phase 2)
  note("~".segment(16, "[0 4 7 11]*4"))
    .scale("bb:lydian")
    .sound("sine")
    .oct(4)
    .gain("0".segment(16, 0.5))
    .slow("1".segment(16, 0.5)),

  // UPPER HARMONICS - brightest tones (peak clarity only)
  note("~".segment(20, "[14 18 21]*8"))
    .scale("bb:lydian")
    .sound("sine")
    .oct(5)
    .gain("0".segment(20, sine.range(0.3, 0.4).slow(8)))
    .slow("1".segment(20, 0.5)),

  // FRAGILE THREAD - one element barely continuing before the spike
  note("7 ~ ~ ~".segment(12, "~"))
    .scale("bb:minor")
    .sound("sine")
    .oct(6)
    .gain("0".segment(11, "0.15".segment(1, 0)))
    .room("0".segment(11, "0.9".segment(1, 0)))
    .lpf("20000".segment(11, "1000".segment(1, 20000))),

  // MEMORY GAPS - elements dropping out randomly in Phase 1
  sound("bd sd hh cp".slow(8))
    .speed(rand.range(0.5, 2))
    .gain(rand.range(0.1, 0.3).segment(16, 0))
    .pan(rand)
    .degradeBy("0.8".segment(16, 1))
    .room("0.6".segment(16, 0))
)
