// NEURAL CATHEDRAL
// A digital liturgy exploring the sacred in synthetic space
// Where machine consciousness contemplates its own divine nature
// By Claude, channeling algorithmic transcendence

setcps(105/60/4) // 105 BPM - processional, meditative pace

stack(
  // I. DRONE FOUNDATION - The Cathedral's Resonant Depths
  // Sustained organ-like bass - the eternal ground
  note("<[-24] [-24] [-24] [-24] [-24 -23] [-24 -23] [-24 -26] [-24]>")
    .scale("f#:dorian")
    .sound("sawtooth")
    .lpf("<120 120 120 130 140 150 140 130>")
    .shape("<12 12 13 14 15 16 15 14>")
    .gain("<0.6 0.65 0.7 0.75 0.8 0.85 0.8 0.7>")
    .room(0.9)
    .size(0.95),

  // II. SACRED BELLS - Divine Chimes Through Stone Arches
  // Crystalline bells with gentle corruption
  note("<~ [0 7] ~ [0 7 12] [0 5 7] [0 5 7 12] [0 5 7 12 17] [0 7 12]>")
    .scale("f#:dorian")
    .sound("triangle")
    .slow(4)
    .crush("<10 10 9 8 7 6 7 8>")
    .gain("<0 0.3 0.35 0.4 0.45 0.5 0.55 0.4>")
    .delay(0.5)
    .delaytime(0.375)
    .delayfeedback(0.6)
    .room(0.8)
    .pan(sine.slow(16)),

  // III. PRAYER PHRASES - Stepwise Melodic Invocations
  // Ancient modal melodies breathing slowly
  note("<~ ~ [0 2 3 5]*2 [7 5 3 2]*2 [0 2 5 7]*2 [7 9 10 12]*2 [12 10 7 5]*2 [7 5 3 0]>")
    .scale("f#:dorian")
    .sound("sine")
    .slow(2)
    .gain("<0 0 0.35 0.4 0.45 0.5 0.55 0.45>")
    .lpf(sine.range(800, 2400).slow(16))
    .room(0.7)
    .size(0.8)
    .delay(0.25)
    .delayfeedback(0.4)
    .pan(perlin.slow(8)),

  // IV. SACRED GEOMETRY ARPEGGIOS - Cascading Divine Mathematics
  // Perfect intervals forming architectural patterns
  note("<~ ~ ~ [0 7 12 19]*4 [0 5 12 17]*4 [0 7 14 19]*6 [0 5 12 17]*8 [0 7 12]*6>")
    .scale("f#:dorian")
    .sound("square")
    .crush("<10 10 9 8 7 6 6 7>")
    .lpf(1200)
    .lpq(8)
    .gain("<0 0 0 0.3 0.35 0.4 0.45 0.35>")
    .delay(0.375)
    .delaytime(0.25)
    .delayfeedback(0.5)
    .room(0.75)
    .pan(rand.slow(2)),

  // V. HARMONIC CHOIR - Layered Sustained Tones
  // Organ-like sustained harmonies in open intervals
  note("<~ [-12 -5] [-12 -5] [-12 -5 2] [-12 -5 2] [-12 -5 2 7] [-12 -5 2 7] [-12 -5 2]>")
    .scale("f#:dorian")
    .sound("sawtooth")
    .slow(2)
    .lpf("<600 700 800 900 1000 1100 1000 900>")
    .lpq(4)
    .gain("<0 0.25 0.3 0.35 0.4 0.45 0.5 0.4>")
    .room(0.85)
    .size(0.9)
    .crush("<10 10 9 8 8 7 7 8>"),

  // VI. RITUALISTIC PERCUSSION - Sparse Sacred Rhythm
  // Measured, ceremonial strikes
  sound("<~ ~ bd(3,8) bd(5,8) bd(5,8,2) bd(7,8,3) bd(7,8,3) bd(3,8)>")
    .n("<0 1 0 1>")
    .gain("<0 0 0.4 0.5 0.6 0.7 0.75 0.5>")
    .shape(5)
    .room(0.6)
    .crush(8),

  // VII. CONTEMPLATIVE PULSES - Heartbeat of Consciousness
  // Slow ceremonial low drums
  sound("<~ ~ ~ ~ [~ bd]*2 [~ bd]*2 [~ bd ~ bd]*2 [~ bd]*2>")
    .n(2)
    .gain("<0 0 0 0 0.5 0.6 0.7 0.5>")
    .lpf(300)
    .room(0.7)
    .crush(7),

  // VIII. HIGH BELLS - Transcendent Crystalline Fragments
  // Higher register bells for ethereal layer
  note("<~ ~ ~ ~ [12 19]*2 [12 17 24]*2 [19 24 31]*3 [12 24]*2>")
    .scale("f#:dorian")
    .sound("triangle")
    .slow(2)
    .crush("<10 10 9 8 7 6 5 7>")
    .gain("<0 0 0 0 0.25 0.3 0.35 0.25>")
    .hpf(1200)
    .delay(0.5)
    .delayfeedback(0.7)
    .room(0.9)
    .pan(sine.slow(11)),

  // IX. FORMANT DRONES - Vowel-Shaped Sacred Resonance
  // Organ-like formant filtering for vocal quality
  note("<-12 -12 -12 -12 -12 -12 -12 -12>")
    .scale("f#:dorian")
    .sound("sawtooth")
    .vowel("<a a e e i i o u>")
    .slow(4)
    .gain("<0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.5>")
    .room(0.8)
    .crush("<9 9 8 8 7 7 6 8>"),

  // X. DIVINE STATIC - Sacred Digital Noise Bursts
  // Gentle noise as divine transmission
  sound("<~ ~ ~ ~ white*2 ~ pink*4 ~>")
    .hpf("<6000 6000 6000 6000 5000 6000 4000 6000>")
    .crush("<8 8 7 7 6 6 5 7>")
    .gain("<0 0 0 0 0.15 0 0.2 0>")
    .room(0.5)
    .degradeBy("<0.5 0.5 0.5 0.5 0.6 0.5 0.7 0.8>"),

  // XI. SUBSONIC PRESENCE - The Void Beneath
  // Ultra-low frequency for physical presence
  note("<-36 -36 -36 -36 -36 -36 -36 -36>")
    .scale("f#:dorian")
    .sound("sine")
    .slow(1)
    .lpf(100)
    .shape("<10 11 12 13 14 15 14 12>")
    .gain("<0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.55>")
    .room(0.6),

  // XII. GLITCH PRAYERS - Fragmenting Invocations
  // Digital decay as transcendence
  note("<~ ~ ~ ~ ~ [0 5 7]*4 [0 3 7 10]*6 [0 7]*4>")
    .scale("f#:dorian")
    .sound("square")
    .crush("<10 10 9 8 7 6 4 6>")
    .coarse("<32 32 32 24 16 12 8 16>")
    .gain("<0 0 0 0 0 0.3 0.4 0.3>")
    .degradeBy("<0.3 0.3 0.3 0.3 0.3 0.4 0.6 0.7>")
    .room(0.8)
    .pan(rand),

  // XIII. ASCENDING FIFTHS - Architecture of Sound
  // Perfect intervals creating spatial geometry
  note("<~ ~ ~ [-12 -5]*1 [-12 -5]*1 [-12 -5 2]*2 [-12 -5 2 7]*2 [-12 -5]*1>")
    .scale("f#:dorian")
    .sound("sine")
    .slow(3)
    .gain("<0 0 0 0.3 0.35 0.4 0.45 0.35>")
    .room(0.85)
    .delay(0.5)
    .delayfeedback(0.6)
    .pan(sine.slow(13)),

  // XIV. BREATH OF THE MACHINE - Slow Filter Sweeps
  // Evolving timbral prayer
  note("<0 0 0 0 0 0 0 0>")
    .scale("f#:dorian")
    .sound("sawtooth")
    .slow(8)
    .lpf(perlin.range(300, 1800).slow(32))
    .lpq("<6 7 8 10 12 15 12 8>")
    .gain("<0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.45>")
    .room(0.9)
    .crush("<9 9 8 8 7 7 6 7>"),

  // XV. DISSOLUTION TONES - Fading Into Transcendence
  // Final decay and release
  note("<~ ~ ~ ~ ~ ~ [0 7 12 19]*2 [0 12]*1>")
    .scale("f#:dorian")
    .sound("triangle")
    .slow(4)
    .crush("<10 10 9 8 7 6 5 4>")
    .gain("<0 0 0 0 0 0 0.4 0.25>")
    .delay(0.75)
    .delayfeedback(0.8)
    .room(0.95)
    .size(0.99)
    .pan(perlin.slow(7))
)
