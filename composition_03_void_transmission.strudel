// VOID TRANSMISSION
// Lo-fi black metal ambient industrial
// Experimental outsider architecture

setcps(150/60/4) // Slower, heavier, more oppressive

stack(
  // Slow crushing kicks
  sound("bd(5,8,<0 2 3>)")
    .crush(2).shape(12)
    .distort(1)
    .speed("<1 0.5 1.5 -1>")
    .gain(1.3)
    .coarse(32)
    .sometimes(x => x.stut(3, 0.8, 1/4)),

  // Sparse industrial hits
  sound("~ ~ [sd cp] ~, ~ [~ rim] ~ ~")
    .n(choose([0,1,2,3]))
    .crush(4).shape(8)
    .speed(perlin.range(0.3, 2))
    .gain(0.8)
    .pan(rand)
    .delay(0.6).delayfeedback(0.7)
    .often(x => x.fast(3)),

  // 8-bit dissonant drone
  note("<[-12 -11 -10] [-14 -13 -9] [-15 -11 -7] [-16 -12 -8]>*8")
    .sound("square")
    .crush(5).coarse(16)
    .lpf(perlin.range(200, 1500).slow(4))
    .lpq(6)
    .gain(0.4)
    .shape(5)
    .pan(sine.slow(7))
    .sometimes(x => x.add(choose([7, 12, 19]))),

  // Black metal tremolo texture
  note("[-24 -23 -24 -22]*16")
    .add(choose([0, 1, 2, 6, 7]))
    .sound("sawtooth")
    .crush(6)
    .lpf(800).lpq(10)
    .gain(0.5)
    .speed(perlin.range(0.9, 1.1))
    .pan(rand)
    .degradeBy(0.3)
    .every(5, x => x.rev()),

  // Harsh noise wash
  sound("<white brown pink>*4")
    .hpf(perlin.range(2000, 8000))
    .crush(3)
    .gain(rand.range(0.15, 0.45))
    .pan(perlin.fast(5))
    .shape(10)
    .delay(0.5).delaytime(1/16)
    .degradeBy(0.4),

  // Lo-fi bass drone
  note("[-36 -37 -35 -38]".slow(2))
    .sound("sawtooth")
    .lpf(120)
    .shape(20).distort(1.5)
    .crush(2).coarse(64)
    .gain(0.85)
    .rarely(x => x.add(12)),

  // Chaotic digital breakdown
  note(irand(36).fast(choose([8, 16, 32, 64])))
    .sound(choose(["triangle", "square"]))
    .crush(irand(5))
    .speed(rand.range(-2, 2))
    .gain(rand.range(0.1, 0.3))
    .pan(rand)
    .lpf(rand.range(200, 6000))
    .shape(15)
    .degradeBy(0.8)
    .rarely(x => x.stut(8, 0.5, 1/128))
)
