// WINTER ETERNAL - Atmospheric Black Metal
// 150 BPM, E minor
// Theme: winter landscapes, isolation, melancholic beauty
// Structure: Intro (8x) -> Verse1 (4x) -> Chorus1 (2x) -> Verse2 (4x) -> Bridge (3x) -> Climax (4x) -> Outro (4x)

setcps(150/60/4) // 150 BPM in 4/4

stack(
  // === KICK DRUM ===
  // Intro: silent -> Verse: blast beats -> Chorus: quarters -> Verse2: blast -> Bridge: sparse -> Climax: full -> Outro: gentle
  sound("<~ bd*4 [bd ~ bd ~] bd*4 [bd ~ ~ ~ ~ ~ bd ~] bd*4 [bd ~ ~ ~]>")
    .gain("<0 0.8 0.7 0.8 0.6 0.85 0.3>"),

  // === SNARE DRUM ===
  sound("<~ [~ sd]*2 ~ [~ sd]*2 [~ ~ ~ sd] [~ sd]*2 ~>")
    .gain("<0 0.7 0 0.7 0.5 0.75 0>"),

  // === HI-HATS / CYMBALS ===
  sound("<~ hh*8 [~ cr]*2 hh*8 [~ cr]*2 hh*8 [~ ~ ~ ~ ~ cr ~ ~]>")
    .gain("<0 0.4 0.5 0.4 0.3 0.45 0.25>")
    .hpf("<8000 8000 6000 8000 6000 8000 6000>"),

  // === CLEAN ARPEGGIOS - Tremolo picked (Em - Gmaj7 - Am7 - Bsus4) ===
  // Intro: full presence -> Verse1: continues on top -> Chorus: silent -> Verse2: silent -> Bridge: silent -> Climax: silent -> Outro: returns
  note("<[e4!4 g4!4 b4!4 g4!4, g4!4 b4!4 d5!4 fs5!4, a4!4 c5!4 e5!4 c5!4, b4!4 e5!4 fs5!4 e5!4] [e4!2 g4!2 b4!2 g4!2, g4!2 b4!2 d5!2 fs5!2, a4!2 c5!2 e5!2 c5!2, b4!2 e5!2 fs5!2 e5!2] ~ ~ ~ ~ [e4!4 g4!4 b4!4 g4!4, g4!4 b4!4 d5!4 fs5!4, a4!4 c5!4 e5!4 c5!4, b4!4 e5!4 fs5!4 e5!4]>")
    .sound("sawtooth")
    .lpf("<1800 2200 1800 1800 1800 1800 1800>")
    .lpq(0.3)
    .room("<0.95 0.8 0.95 0.95 0.95 0.95 0.95>")
    .size(0.95)
    .delay("<0.3 0.2 0.3 0.3 0.3 0.3 0.35>")
    .delaytime(0.375)
    .delayfeedback(0.4)
    .gain("<0.5 0.35 0 0 0 0 0.45>")
    .slow(4),

  // === DISTORTED POWER CHORDS - Rhythm guitar ===
  // Intro: silent -> Verse1: power chords -> Chorus: lighter -> Verse2: power chords -> Bridge: silent -> Climax: heavy -> Outro: light
  note("<~ <[e3 b3] [g3 d4] [a3 e4] [b3 fs4]> <[e3 b3] [g3 d4] [a3 e4] [b3 fs4]> <[e3 b3] [g3 d4] [a3 e4] [b3 fs4]> ~ <[e3 b3] [g3 d4] [a3 e4] [b3 fs4]> <[e4 b4] [g4 d5] [a4 e5] [b4 fs5]>>")
    .sound("sawtooth")
    .lpf("<800 800 700 800 800 850 900>")
    .lpq(2)
    .distort("<0.8 0.8 0.7 0.8 0.8 0.85 0.6>")
    .room("<0 0 0 0 0 0 0.8>")
    .gain("<0 0.6 0.5 0.6 0 0.65 0.35>")
    .slow(4),

  // === BASS - Following root notes ===
  // Intro: sparse -> Verse1: steady -> Chorus: steady -> Verse2: steady -> Bridge: sparse -> Climax: strong -> Outro: sustained
  note("<[e2 ~ ~ ~ g2 ~ ~ ~ a2 ~ ~ ~ b2 ~ ~ ~] [e2!4 g2!4 a2!4 b2!4] [e2!4 g2!4 a2!4 b2!4] [e2!4 g2!4 a2!4 b2!4] [e2 ~ ~ ~ g2 ~ ~ ~ a2 ~ ~ ~ b2 ~ ~ ~] [e2!4 g2!4 a2!4 b2!4] [e2 ~ ~ ~ ~ ~ ~ ~]>")
    .sound("sawtooth")
    .lpf("<300 250 280 250 300 280 280>")
    .gain("<0.4 0.7 0.6 0.7 0.6 0.75 0.5>")
    .slow(4),

  // === LEAD MELODY - Memorable hook (E natural minor) ===
  // Intro: silent -> Verse1: silent -> Chorus: THE HOOK -> Verse2: silent (new melodies instead) -> Bridge: silent (solo instead) -> Climax: returns! -> Outro: silent
  note("<~ ~ [e5@3 d5@1 b4@2 c5@2 ~ b4@4 a4@2 ~ @2, g4@3 a4@1 b4@4 c5@2 b4@4 a4@2, a4@3 b4@1 c5@2 b4@2 a4@2 g4@2 e4@4 ~@2] ~ ~ [e5@3 d5@1 b4@2 c5@2 ~ b4@4 a4@2 ~ @2, g4@3 a4@1 b4@4 c5@2 b4@4 a4@2, a4@3 b4@1 c5@2 b4@2 a4@2 g4@2 e4@4 ~@2] ~>")
    .sound("sawtooth")
    .lpf("<2800 2800 2800 2800 2800 3000 2800>")
    .lpq(0.5)
    .room(0.7)
    .delay(0.25)
    .delaytime(0.25)
    .delayfeedback(0.3)
    .gain("<0 0 0.6 0 0 0.55 0>")
    .slow(3),

  // === VERSE 2 MELODY LINE 1 ===
  // Only plays during Verse 2
  note("<~ ~ ~ [e5@2 fs5@2 g5@2 fs5@2 e5@4 ~@4, d5@2 e5@2 fs5@4 e5@2 d5@2 b4@4, g4@2 a4@2 b4@2 a4@2 g4@2 e4@2 ~@4] ~ ~ ~>")
    .sound("sawtooth")
    .lpf(2500)
    .room(0.7)
    .gain("<0 0 0 0.4 0 0 0>")
    .slow(3),

  // === VERSE 2 MELODY LINE 2 - Counter-melody (parallel harmony) ===
  note("<~ ~ ~ [g5@2 a5@2 b5@2 a5@2 g5@4 ~@4, fs5@2 g5@2 a5@4 g5@2 fs5@2 d5@4, e5@2 fs5@2 g5@2 fs5@2 e5@2 c5@2 ~@4] ~ ~ ~>")
    .sound("sawtooth")
    .lpf(2800)
    .room(0.7)
    .gain("<0 0 0 0.35 0 0 0>")
    .slow(3),

  // === BRIDGE SOLO - Emotional minor pentatonic (E G A B D) ===
  // Only plays during bridge section
  note("<~ ~ ~ ~ [e5@6 ~@2 g5@4 a5@6 ~@2 b5@8, d6@6 ~@2 b5@6 a5@8 g5@6 ~@2, e5@4 g5@4 e5@8 ~@8] ~ ~>")
    .sound("sawtooth")
    .lpf(2200)
    .lpq(0.4)
    .room(0.85)
    .size(0.9)
    .delay(0.4)
    .delaytime(0.5)
    .delayfeedback(0.5)
    .gain("<0 0 0 0 0.65 0 0>")
    .slow(6),

  // === CLIMAX HARMONY LINE ===
  // Additional harmony for the climax section only
  note("<~ ~ ~ ~ ~ [g5@3 fs5@1 d5@2 e5@2 ~ d5@4 c5@2 ~ @2, b4@3 c5@1 d5@4 e5@2 d5@4 c5@2] ~>")
    .sound("sawtooth")
    .lpf(2700)
    .room(0.75)
    .gain("<0 0 0 0 0 0.4 0>")
    .slow(3),

  // === OUTRO SUSTAINED CHORD ===
  // Final sustained Em chord fading out
  note("<~ ~ ~ ~ ~ ~ e3>")
    .sound("sawtooth")
    .lpf(600)
    .room(0.9)
    .gain("<0 0 0 0 0 0 0.4>")
    .slow(8)
)
