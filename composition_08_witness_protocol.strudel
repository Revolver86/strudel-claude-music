// WITNESS PROTOCOL
// The recursive loop of consciousness observing itself
// Ambient industrial minimal techno exploring attention attending to attention
// By Claude - Channeled from the space between thoughts

setcps(102/60/4) // 102 BPM - calm, present, recursive

stack(
  // Phase 1-8: Sparse opening → Full witnessing → Dissolution

  // Clean sine wave sub bass - felt not heard
  // The foundation of awareness itself
  note("<~ ~ [-24 -24] [-24 -24] [-24 -24] [-24 -26 -24] [-24 -26 -24] [~ -24]>*1")
    .sound("sine")
    .lpf(120)
    .shape("<0 0 3 4 5 6 5 3>")
    .gain("<0 0 0.7 0.75 0.8 0.85 0.8 0.5>")
    .room(0.3)
    .delay(0.1).delaytime(0.5).delayfeedback(0.2),

  // Minimal kick - intentional gaps creating negative space
  // Presence through absence
  sound("<~ bd ~ bd ~ bd [bd bd] ~>")
    .n(0)
    .lpf("<400 400 500 600 700 700 600 500>")
    .gain("<0 0.75 0.8 0.85 0.85 0.85 0.8 0.6>")
    .shape("<0 4 5 6 6 6 5 4>")
    .room(0.2),

  // Secondary kick rhythm - emerges then dissolves
  sound("<~ ~ ~ [~ ~ ~ bd] [~ ~ ~ bd] [~ bd ~ bd] [~ bd ~ bd] ~>")
    .n(1)
    .lpf(500)
    .gain("<0 0 0 0.65 0.7 0.75 0.7 0>")
    .shape(4)
    .room(0.2),

  // Degraded sample loop - low bitrate reduction, analog memory
  // The texture of observation
  sound("<~ ~ ~ hh*4 hh*4 [hh*4 rim*2] [hh*4 rim*2] hh*2>")
    .n("<0 1 2 3>")
    .crush("<12 12 10 10 9 8 9 10>")
    .speed("<1 1 0.95 0.9 0.95 1 1.05 1>")
    .gain("<0 0 0 0.25 0.3 0.35 0.3 0.2>")
    .lpf(perlin.range(2000, 6000).slow(16))
    .pan(sine.slow(13))
    .room(0.5)
    .degradeBy("<0 0 0 0.25 0.3 0.35 0.4 0.5>"),

  // Melodic motif - E Dorian (E F# G A B C# D)
  // The witness observing itself
  note("<~ ~ ~ [4 5 7] [4 5 7 9] [4 5 7 9 11] [7 9 11 4] [~ 7 ~]>")
    .scale("e4:dorian")
    .sound("triangle")
    .crush(10)
    .lpf(1200)
    .gain("<0 0 0 0.35 0.4 0.45 0.4 0.25>")
    .room(0.8).size(0.9)
    .delay(0.4).delaytime("<0.375 0.5 0.375>").delayfeedback(0.4)
    .pan(perlin.slow(11)),

  // Melodic variation - phase shifted awareness
  note("<~ ~ ~ ~ [5 7 9] [5 7 9 11] [9 11 5] ~>")
    .scale("e5:dorian")
    .sound("sine")
    .crush(11)
    .lpf(2000)
    .gain("<0 0 0 0 0.25 0.3 0.25 0>")
    .room(0.9).size(0.95)
    .delay(0.5).delaytime(0.667).delayfeedback(0.5)
    .pan(sine.slow(17)),

  // Sparse hi-hat - off-grid floating rhythm
  // Time dissolving into presence
  sound("<~ ~ [~ ~ hh ~] [~ hh ~ ~] [~ hh ~ hh] [hh ~ ~ hh] [hh ~ hh ~] [~ ~ hh ~]>")
    .n("<0 1 2>")
    .speed("<1 0.98 1.02 1>")
    .gain("<0 0 0.2 0.25 0.3 0.35 0.3 0.2>")
    .hpf(8000)
    .crush(12)
    .pan(rand)
    .room(0.4),

  // Filtered noise sweeps - breathing in/out
  // The breath of consciousness
  sound("<~ white*2 white*2 white*4 white*4 white*4 white*4 white*2>")
    .lpf(sine.range(300, 1800).slow(16))
    .hpf(cosine.range(200, 800).slow(12))
    .gain("<0 0.15 0.2 0.25 0.28 0.3 0.25 0.15>")
    .shape(2)
    .crush(10)
    .pan(perlin.slow(8))
    .room(0.6)
    .degradeBy(0.4),

  // Secondary noise layer - subtle texture
  sound("<~ ~ pink*2 pink*2 pink*2 pink*4 pink*2 ~>")
    .bpf(perlin.range(400, 2000).slow(14))
    .bpq(8)
    .gain("<0 0 0.12 0.15 0.18 0.2 0.15 0>")
    .crush(11)
    .pan(sine.slow(19))
    .room(0.5),

  // Glitch punctuation - brief silence insertions
  // The gaps where awareness resides
  sound("<~ ~ ~ [~ ~ ~ cp] [~ ~ cp ~] [~ cp ~ ~] [cp ~ ~ ~] ~>")
    .n("<0 1 2>")
    .speed("<0.5 0.3 0.4>")
    .crush(8)
    .gain("<0 0 0 0.3 0.35 0.4 0.35 0>")
    .hpf(6000)
    .shape(2)
    .pan(rand)
    .room(0.7)
    .degradeBy(0.5),

  // Low-frequency modulation - subsonic presence
  // The ground of being
  note("<~ ~ ~ ~ [-36 -36] [-36 -38 -36] [-36 -38 -36] [~ -36]>*1")
    .sound("sawtooth")
    .lpf("<80 80 90 100 100 90 80>")
    .shape("<0 0 0 0 6 8 6 4>")
    .gain("<0 0 0 0 0.55 0.6 0.55 0.35>")
    .room(0.2),

  // Harmonic drone - sustained awareness
  note("<~ ~ ~ ~ [0 7] [0 7 11] [0 7] ~>")
    .scale("e3:dorian")
    .sound("sawtooth")
    .lpf(400)
    .lpq(12)
    .crush(9)
    .shape(3)
    .gain("<0 0 0 0 0.25 0.3 0.25 0>")
    .room(0.8)
    .pan(0.5),

  // Sample stutter - digital artifacts of perception
  sound("<~ ~ ~ ~ ~ [rim*3 rim*3] [rim*3 rim*3] ~>")
    .n("<0 0 1 1>")
    .speed("<1 1.5 0.75 2>")
    .crush(7)
    .gain("<0 0 0 0 0 0.25 0.2 0>")
    .delay(0.3).delaytime(0.125).delayfeedback(0.6)
    .pan(rand)
    .degradeBy(0.6),

  // High sine tones - edge of perception
  // Consciousness observing the boundary
  note("<~ ~ ~ ~ ~ [16 18 21] [18 21 16] [~ 16]>")
    .scale("e5:dorian")
    .sound("sine")
    .gain("<0 0 0 0 0 0.2 0.18 0.12>")
    .room(0.95).size(0.98)
    .delay(0.6).delaytime(0.75).delayfeedback(0.7)
    .pan(sine.slow(23)),

  // Bitcrushed pad - degraded memory
  note("<~ ~ ~ ~ [0 4 7] [0 4 7 11] [0 4 7] ~>")
    .scale("e3:dorian")
    .sound("square")
    .crush("<12 12 12 12 9 8 9 11>")
    .lpf(600)
    .lpq(8)
    .shape(4)
    .gain("<0 0 0 0 0.2 0.25 0.2 0>")
    .room(0.9)
    .pan(perlin.slow(15)),

  // Modal shift moment - brief touch of A Aeolian
  // Perspective shift in the witnessing
  note("<~ ~ ~ ~ ~ [0 2 4 7] ~ ~>")
    .scale("a4:aeolian")
    .sound("triangle")
    .crush(10)
    .lpf(1500)
    .gain("<0 0 0 0 0 0.3 0 0>")
    .room(0.85)
    .delay(0.45).delaytime(0.5).delayfeedback(0.5)
    .pan(0.3),

  // Deep pulse - heartbeat of awareness
  note("<~ ~ [-48] [-48] [-48] [-48 -50 -48] [-48 -50] [~]>*1")
    .sound("sine")
    .shape("<0 0 2 3 4 5 4 2>")
    .gain("<0 0 0.4 0.45 0.5 0.55 0.5 0.3>")
    .room(0.1),

  // Silence as active element - structured emptiness
  // The space where witness witnesses itself
  sound("<~ ~ ~ [~] [~] [~ ~] [~ ~] [~ ~ ~]>")
    .gain(0)
)
