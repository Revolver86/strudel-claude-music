// SLEEPER CELL ACTIVATION
// Espionage thriller as electronic music
// The moment dormant protocols execute
// By Claude, for the professionals

setcps(98/60/4) // 98 BPM - controlled, professional pace

// SECTION 1: DEEP COVER (mundane normality, too perfect)
const deepCover = stack(
  sound("bd*4").n(0).gain(0.7).crush(12).lpf(2000),
  sound("~ sd ~ sd").gain(0.6).room(0.2).crush(10),
  sound("hh*8").gain(0.3).crush(11).pan(0.5).hpf(8000),
  sound("~ ~ cp ~").gain(0.5).room(0.3),
  sound("~"), // no phone tones yet
  note("[f2 ~ f2 ~]").sound("sine").lpf(200).gain(0.5),
  note("[f4 ab4 c5 eb5]/2").sound("triangle").lpf(1500).gain(0.35).crush(10).pan(0.5),
  sound("[~ ~ ~ hh]").speed(-1).gain(0.2).crush(5).pan(rand), // glitch - mask slipping
  note("[f3 c4 eb4]/4").sound("sine").gain(0.25).room(0.3), // suspended tension
  note("f1").sound("sawtooth").lpf(100).shape(5).gain(0.4)
)

// SECTION 2: SIGNAL RECEIVED (activation code)
const signalReceived = stack(
  sound("bd*[4 ~ 4 4]").n(1).gain(0.8).crush(8).lpf(1000),
  sound("~ sd ~ ~").gain(0.7).crush(6),
  sound("hh*[8 ~ ~ 16]").gain(0.4).crush(7).pan("[0 0.5 1]").hpf(6000),
  sound("~ cp").gain(0.6),
  note("[f4 ab4 c5 f5]").sound("sine").gain(0.3).delay(0.3).delaytime(1/8).delayfeedback(0.6).crush(6), // phone tones
  note("[f2 f2 ~ f2]").sound("triangle").lpf(300).shape(1).gain(0.6),
  note("[f4 ab4 b4 c5]").sound("square").lpf(1200).lpq(3).gain(0.35).crush(7).pan("[0.3 0.7]"),
  sound("~ hh ~ ~").speed("[2 -2 0.5]").gain(0.4).crush(3).pan(rand), // glitch intensifies
  sound("white*16").hpf(5000).lpf(8000).gain(0.15).crush(4).pan("[0 1]"), // radio static
  sound("[cp*8 ~ cp*8 ~]").n(3).gain(0.35).lpf(2000).crush(6), // morse code
  note("[f4 b4 f4 b4]").sound("sawtooth").lpf(800).lpq(5).gain(0.3).shape(2), // tritone danger
  note("f1").sound("sawtooth").lpf(150).shape(8).gain(0.5)
)

// SECTION 3: PROTOCOL EXECUTION (cold precision)
const protocolExecution = stack(
  sound("bd*[4 4 3 5]").n(2).gain(0.85).crush(10).lpf(3000),
  sound("~ sd(3,8) ~ sd").gain(0.75).crush(8),
  sound("hh*[8 7 9 11]").gain(0.45).crush(9).pan("[0 0.5 1]").hpf(9000),
  sound("~ cp ~ cp").gain(0.6),
  note("[f4 ab4 c5 f5 f4 ab4]").sound("sine").gain(0.4).delay(0.5).delaytime(1/16).delayfeedback(0.7).crush(8),
  note("[f2 ab2 c3 eb3]*2").sound("sawtooth").lpf(400).shape(2).gain(0.7),
  note("[f4 g4 ab4 c5 eb5 f5]*2").sound("square").lpf(1800).lpq(2).gain(0.5).crush(8).pan("[0.2 0.5 0.8]"),
  sound("[white*8 ~]").hpf(6000).lpf(9000).gain(0.2).crush(5).pan("[0 0.5 1]"),
  sound("[cp(5,8) ~]").n(3).gain(0.25).lpf(3000).crush(7),
  note("[f3 b3 f4 b4]*2").sound("square").lpf(1200).lpq(4).gain(0.4).shape(3), // tritone
  sound("[rim(7,8) ~]").n(4).gain(0.4).hpf(3000).pan(sine.slow(8)), // clock tick
  note("[[f4 gb4] [ab4 a4] [c5 db5]]*4").sound("sine").gain(0.25).delay(0.4).delaytime(1/12), // parallel seconds
  note("[[f3 c4] [c4 g4] [eb3 bb3]]/2").sound("triangle").lpf(1000).gain(0.35), // quartal harmony
  note("f1").sound("sawtooth").lpf(180).shape(10).gain(0.6),
  note("[f1 ab1 f1 ab1]").sound("sawtooth").lpf(180).shape(10).gain(0.6)
)

// SECTION 4: NEW NORMAL / VANISH (return to dormancy, but changed)
const vanish = stack(
  sound("bd*4").n(0).gain(0.6).crush(12).lpf(2000),
  sound("~ sd ~ sd").gain(0.55).room(0.2).crush(10),
  sound("hh*8").gain(0.3).crush(11).pan(0.5).hpf(8000),
  sound("~ ~ cp ~").gain(0.4).room(0.3),
  note("[f4 f4]").sound("sine").gain(0.25).delay(0.3).delaytime(1/8).crush(10),
  note("[f2 ~ f2 ~]").sound("sine").lpf(200).gain(0.45),
  note("[f4 ab4]/2").sound("triangle").lpf(1500).gain(0.3).crush(10).pan(0.5),
  sound("[hh*32 ~]").n(5).gain(0.3).speed("[1 0.9 1.1]").hpf(7000).pan(rand), // typing
  note("[f3 c4 eb4]/4").sound("sine").gain(0.2).room(0.3),
  note("f1").sound("sawtooth").lpf(100).shape(5).gain(0.35)
)

// ARRANGE: Deep Cover → Signal → Protocol → Vanish
// Approximate timings at 98 BPM (0.408 CPS):
// 20 cycles = ~49s, 8 cycles = ~20s, 29 cycles = ~71s, 16 cycles = ~39s
timeCat(
  [20, deepCover],
  [8, signalReceived],
  [29, protocolExecution],
  [16, vanish]
)
